# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: FPT AI Factory (OpenAI-compatible API)
LLM_PROVIDER=fpt
LLM_MODEL=DeepSeek-V4-Flash
FPT_BASE_URL=https://mkp-api.fptcloud.com

# Generation providers
FPT_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=0.50
